# Pinned toolchain and third-party versions.
# When bumping GODOT_VERSION, keep this file and any future CI pins in sync.

GODOT_VERSION=4.6.3
# Optional override for a local Godot / GodotSteam editor binary.
# When unset or missing, tooling falls back to .cache/godot/ after make setup-godot.
GODOT_EDITOR_WIN=
GODOTSTEAM_VERSION=4.19.1
# CI release-only pins (stock Godot export templates). Not a local setup step.
GODOTSTEAM_GDE_RELEASE_TAG=v4.19.1-gde
GODOTSTEAM_GDE_ZIP=godotsteam-4.19.1-gdextension-plugin-4.4.zip
GDVOSK_RELEASE_TAG=v1.0
GDVOSK_ZIP=gdvosk_1.0.0.zip
VOSK_MODEL_ZIP=vosk-model-small-en-us-0.15.zip

# netfox: PredictiveSynchronizer + rollback liveness (not in the 1.35.3 GitHub zip).
# Do not vendor netfox.noray.
NETFOX_VERSION=1.48.4
NETFOX_COMMIT=1e7281de3e48f797287813b83f731a01e05775f8
NETFOX_SOURCE=https://github.com/foxssake/netfox
