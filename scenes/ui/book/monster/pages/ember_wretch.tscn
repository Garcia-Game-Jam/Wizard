[gd_scene load_steps=4 format=3]

[ext_resource type="PackedScene" path="res://scenes/ui/book/page_leaf.tscn" id="1_leaf"]
[ext_resource type="Script" path="res://scripts/ui/book/monster/monster_page.gd" id="2_page"]
[ext_resource type="Resource" path="res://resources/monsters/ember_wretch.tres" id="3_entry"]

[node name="EmberWretchPage" instance=ExtResource("1_leaf")]
