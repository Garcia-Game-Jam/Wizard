[node name="TitleLabel" parent="Margin/VBox" index="0"]
text = "Charger"

[node name="SubtitleLabel" parent="Margin/VBox" index="1"]
text = "Summon"

[node name="BodyLabel" parent="Margin/VBox" index="2"]
text = "A stocky, horned rammer. Nearly deaf, but it sees a long way in front of itself. If it spots you it winds up, raises a ward, and rams in a locked line."

[node name="HintLabel" parent="Margin/VBox" index="4"]
text = "[Q] / [E] turn pages. Select to place."

[node name="SelectButton" type="Button" parent="Margin/VBox" index="5"]
