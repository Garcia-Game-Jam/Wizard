[node name="Pads" type="Node3D" parent="." unique_id=587173666]
editor_description = "PadN and ZoneN/SpawnPointN are generated by ../Gates (colosseum_gate_ring.gd). PadN sits just inside its gate (telegraph light anchor only). ZoneN is a walkable platform just outside its gate, and SpawnPointN — the node arena_scene.gd actually spawns monsters on — sits at its center, facing in. Do not add any of these by hand."

