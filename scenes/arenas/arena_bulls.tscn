[node name="ArenaBulls" type="Node3D" unique_id=248825525]
editor_description = "Colosseum match arena. Same spawning contract as scenes/arena.tscn (arena_scene.gd), swapped for a round floor, a ring wall, and 8 domed gates. A gate opens (its door lowers into the floor) while its telegraph light is shown; monsters actually spawn on a platform just outside that gate once the telegraph timer ends, then walk in through the opening — see Gates/colosseum_gate_ring.gd, which generates Gate/Pad/Zone/SpawnPoint/Spot/Omni/Beam/Ring for all 8 from one angle array."
script = ExtResource("1_arena")

